# HotelPro Backend Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Provide a valid MongoDB URI; fallback in-memory engine activates if unavailable)
MONGODB_URI=mongodb://localhost:27017/hotelpro

# JWT Authentication Secrets (Replace with a strong random string in production)
JWT_SECRET=your_jwt_secret_key_placeholder
JWT_EXPIRES_IN=7d

# Hotel Configuration
HOTEL_NAME=HotelPro Luxury Resort & Suites
HOTEL_EMAIL=concierge@hotelpro.com
HOTEL_TAX_RATE=0.10
HOTEL_SERVICE_FEE=25
